# AWS auth: named SSO profile (recommended) or default credentials chain
# AWS_PROFILE=your-sso-profile
# Bench standardizes on us-west-2 / Claude Sonnet 4.6 (ADR 0004: model access is there).
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
ONBOARDING_STATE_TABLE=onboarding-state-dev
ONBOARDING_DOCS_BUCKET=onboarding-docs-dev

# Bench domain (feature flag, opt-in)
BENCH_ENABLED=1
# Optional LLM summary in the daily-cycle graph (needs AWS credentials + Bedrock access)
BENCH_USE_LLM=0
# Shared bearer token guarding /api/v1 (leave unset for local dev; set it for a pilot).
# The Teams bot must send the same value as BENCH_API_TOKEN.
# BENCH_API_TOKEN=change-me
