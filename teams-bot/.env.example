# Teams bot (thin channel — ADR 0004). Copy to .env and fill in.
# Entra/bot registration (provisioned by the M365 Agents Toolkit on F5):
PORT=3978
CLIENT_ID=
CLIENT_SECRET=
TENANT_ID=

# Bench service URL (bench/api.py). The bot has NO AWS credentials:
# Bedrock is called by the Bench service, not here.
BENCH_BACKEND_URL=http://localhost:8000
# Shared bearer token for the service API (must match the service's BENCH_API_TOKEN).
# Leave empty when the service runs open (local dev).
BENCH_API_TOKEN=
